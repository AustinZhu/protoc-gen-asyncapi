{
  "$id": "urn:acme:orders",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACME Orders",
  "description": "Order management for the ACME shop.\n\nClients place orders with request/reply; order lifecycle events are\npublished to the ORDERS JetStream stream and consumed by the fulfilment\nworkers.",
  "anyOf": [
    {
      "$ref": "#/$defs/acme.orders.v1.PlaceOrderRequest"
    },
    {
      "$ref": "#/$defs/acme.orders.v1.Order"
    },
    {
      "$ref": "#/$defs/acme.orders.v1.GetOrderRequest"
    },
    {
      "$ref": "#/$defs/nats.micro.PingResponse"
    },
    {
      "$ref": "#/$defs/nats.micro.InfoResponse"
    },
    {
      "$ref": "#/$defs/nats.micro.StatsResponse"
    },
    {
      "$ref": "#/$defs/acme.orders.v1.OrderPlacedEvent"
    },
    {
      "$ref": "#/$defs/acme.orders.v1.Cart"
    },
    {
      "$ref": "#/$defs/nats.jetstream.PubAck"
    }
  ],
  "$defs": {
    "acme.orders.v1.PlaceOrderRequest": {
      "type": "object",
      "properties": {
        "customerId": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acme.orders.v1.LineItem"
          }
        },
        "cardToken": {
          "type": "string"
        },
        "voucherCode": {
          "type": "string"
        }
      },
      "required": [
        "customerId"
      ],
      "oneOf": [
        {
          "required": [
            "cardToken"
          ]
        },
        {
          "required": [
            "voucherCode"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "cardToken"
                ]
              },
              {
                "required": [
                  "voucherCode"
                ]
              }
            ]
          }
        }
      ]
    },
    "acme.orders.v1.LineItem": {
      "description": "A line of an order.",
      "type": "object",
      "properties": {
        "sku": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "acme.orders.v1.Order": {
      "description": "An order.",
      "type": "object",
      "properties": {
        "orderId": {
          "description": "Unique order ID.",
          "type": "string",
          "examples": [
            "ord_123"
          ]
        },
        "customerId": {
          "description": "Customer that placed the order.",
          "type": "string"
        },
        "items": {
          "description": "Ordered items.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/acme.orders.v1.LineItem"
          }
        },
        "status": {
          "description": "Current status.",
          "allOf": [
            {
              "$ref": "#/$defs/acme.orders.v1.Order.Status"
            }
          ]
        },
        "placedAt": {
          "description": "When the order was placed.",
          "type": "string",
          "format": "date-time"
        },
        "totalCents": {
          "description": "Total in cents.",
          "type": "string",
          "format": "int64",
          "pattern": "^-?[0-9]+$"
        }
      }
    },
    "acme.orders.v1.Order.Status": {
      "description": "Lifecycle of an order.\n\n- `STATUS_PENDING` (1): Awaiting payment.\n- `STATUS_PAID` (2): Paid and ready to ship.\n- `STATUS_SHIPPED` (3): Handed over to the carrier.",
      "type": "string",
      "enum": [
        "STATUS_UNSPECIFIED",
        "STATUS_PENDING",
        "STATUS_PAID",
        "STATUS_SHIPPED"
      ]
    },
    "acme.orders.v1.GetOrderRequest": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string"
        }
      },
      "required": [
        "orderId"
      ]
    },
    "nats.micro.PingResponse": {
      "description": "Reply to `$SRV.PING` (`io.nats.micro.v1.ping_response`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "io.nats.micro.v1.ping_response"
        },
        "name": {
          "description": "Service name.",
          "type": "string"
        },
        "id": {
          "description": "Instance identifier.",
          "type": "string"
        },
        "version": {
          "description": "Service version (semver).",
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "name",
        "id",
        "version"
      ]
    },
    "nats.micro.InfoResponse": {
      "description": "Reply to `$SRV.INFO` (`io.nats.micro.v1.info_response`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "io.nats.micro.v1.info_response"
        },
        "name": {
          "description": "Service name.",
          "type": "string"
        },
        "id": {
          "description": "Instance identifier.",
          "type": "string"
        },
        "version": {
          "description": "Service version (semver).",
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "description": {
          "description": "Service description.",
          "type": "string"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "description": "Endpoint name.",
                "type": "string"
              },
              "subject": {
                "description": "Subject the endpoint listens on.",
                "type": "string"
              },
              "queue_group": {
                "description": "Queue group of the endpoint.",
                "type": "string"
              },
              "metadata": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "required": [
        "type",
        "name",
        "id",
        "version"
      ]
    },
    "nats.micro.StatsResponse": {
      "description": "Reply to `$SRV.STATS` (`io.nats.micro.v1.stats_response`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "io.nats.micro.v1.stats_response"
        },
        "name": {
          "description": "Service name.",
          "type": "string"
        },
        "id": {
          "description": "Instance identifier.",
          "type": "string"
        },
        "version": {
          "description": "Service version (semver).",
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "started": {
          "description": "Start time of the instance.",
          "type": "string",
          "format": "date-time"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "description": "Endpoint name.",
                "type": "string"
              },
              "subject": {
                "description": "Subject the endpoint listens on.",
                "type": "string"
              },
              "queue_group": {
                "description": "Queue group of the endpoint.",
                "type": "string"
              },
              "num_requests": {
                "description": "Number of requests received.",
                "type": "integer"
              },
              "num_errors": {
                "description": "Number of errors returned.",
                "type": "integer"
              },
              "last_error": {
                "description": "Last error returned.",
                "type": "string"
              },
              "processing_time": {
                "description": "Total processing time in nanoseconds.",
                "type": "integer"
              },
              "average_processing_time": {
                "description": "Average processing time in nanoseconds.",
                "type": "integer"
              },
              "data": {
                "description": "Custom statistics."
              }
            }
          }
        }
      },
      "required": [
        "type",
        "name",
        "id",
        "version"
      ]
    },
    "acme.orders.v1.OrderPlacedEvent": {
      "description": "Published when an order has been placed.",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string"
        },
        "order": {
          "$ref": "#/$defs/acme.orders.v1.Order"
        }
      }
    },
    "acme.orders.v1.Cart": {
      "description": "A shopping cart.",
      "type": "object",
      "properties": {
        "customerId": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acme.orders.v1.LineItem"
          }
        },
        "coupon": {
          "type": "string"
        }
      }
    },
    "nats.jetstream.PubAck": {
      "type": "object",
      "properties": {
        "stream": {
          "description": "Stream the message was stored in.",
          "type": "string"
        },
        "seq": {
          "description": "Sequence of the message in the stream.",
          "type": "integer",
          "minimum": 0
        },
        "duplicate": {
          "description": "The message was a duplicate and was not stored again.",
          "type": "boolean"
        },
        "domain": {
          "description": "JetStream domain.",
          "type": "string"
        },
        "batch": {
          "description": "Batch identifier for atomic batch publishes.",
          "type": "string"
        },
        "count": {
          "description": "Number of messages committed by an atomic batch.",
          "type": "integer"
        },
        "error": {
          "description": "Set when the message was rejected.",
          "type": "object",
          "properties": {
            "code": {
              "type": "integer"
            },
            "err_code": {
              "type": "integer"
            },
            "description": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
