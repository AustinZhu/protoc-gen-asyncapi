{
  "asyncapi": "3.0.0",
  "id": "urn:acme:orders",
  "info": {
    "title": "ACME Orders",
    "version": "9.9.9",
    "description": "Order management for the ACME shop.\n\nClients place orders with request/reply; order lifecycle events are\npublished to the ORDERS JetStream stream and consumed by the fulfilment\nworkers.",
    "contact": {
      "name": "Orders team",
      "email": "orders@acme.example"
    },
    "license": {
      "name": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    },
    "tags": [
      {
        "name": "OrderService",
        "description": "Orders exposes the order API as a NATS micro service."
      },
      {
        "name": "OrderEvents",
        "description": "OrderEvents are published by the order service."
      },
      {
        "name": "Fulfilment",
        "description": "Fulfilment consumes order events."
      }
    ]
  },
  "servers": {
    "production": {
      "host": "nats.acme.example:4222",
      "protocol": "nats",
      "protocolVersion": "2.11",
      "description": "Production super-cluster.",
      "security": [
        {
          "$ref": "#/components/securitySchemes/creds"
        }
      ],
      "x-nats": {
        "tls": true
      }
    },
    "local": {
      "host": "localhost:4222",
      "protocol": "nats",
      "description": "`nats-server -js` on your machine."
    }
  },
  "defaultContentType": "application/json",
  "channels": {
    "orders.place": {
      "address": "orders.place",
      "messages": {
        "acme.orders.v1.PlaceOrderRequest": {
          "$ref": "#/components/messages/acme.orders.v1.PlaceOrderRequest"
        }
      }
    },
    "orders.place.reply": {
      "address": null,
      "messages": {
        "acme.orders.v1.Order": {
          "$ref": "#/components/messages/acme.orders.v1.Order"
        },
        "nats.micro.Error": {
          "$ref": "#/components/messages/nats.micro.Error"
        }
      },
      "description": "Replies to requests sent on `orders.place`. NATS delivers them to the reply subject (usually a unique `_INBOX` subject) chosen by the requester."
    },
    "orders.order_id.get": {
      "address": "orders.{order_id}.get",
      "messages": {
        "acme.orders.v1.GetOrderRequest": {
          "$ref": "#/components/messages/acme.orders.v1.GetOrderRequest"
        }
      },
      "parameters": {
        "order_id": {
          "location": "$message.payload#/orderId"
        }
      }
    },
    "orders.order_id.get.reply": {
      "address": null,
      "messages": {
        "acme.orders.v1.Order": {
          "$ref": "#/components/messages/acme.orders.v1.Order"
        },
        "nats.micro.Error": {
          "$ref": "#/components/messages/nats.micro.Error"
        }
      },
      "description": "Replies to requests sent on `orders.{order_id}.get`. NATS delivers them to the reply subject (usually a unique `_INBOX` subject) chosen by the requester."
    },
    "SRV.PING.orders": {
      "address": "$SRV.PING.orders",
      "messages": {
        "nats.micro.DiscoveryRequest": {
          "$ref": "#/components/messages/nats.micro.DiscoveryRequest"
        }
      },
      "description": "NATS micro discovery. Instances also answer on `$SRV.PING` (all services) and `$SRV.PING.orders.<id>` (a single instance)."
    },
    "SRV.PING.orders.reply": {
      "address": null,
      "messages": {
        "nats.micro.PingResponse": {
          "$ref": "#/components/messages/nats.micro.PingResponse"
        }
      },
      "description": "Replies of the service instances, sent to the inbox of the requester."
    },
    "SRV.INFO.orders": {
      "address": "$SRV.INFO.orders",
      "messages": {
        "nats.micro.DiscoveryRequest": {
          "$ref": "#/components/messages/nats.micro.DiscoveryRequest"
        }
      },
      "description": "NATS micro discovery. Instances also answer on `$SRV.INFO` (all services) and `$SRV.INFO.orders.<id>` (a single instance)."
    },
    "SRV.INFO.orders.reply": {
      "address": null,
      "messages": {
        "nats.micro.InfoResponse": {
          "$ref": "#/components/messages/nats.micro.InfoResponse"
        }
      },
      "description": "Replies of the service instances, sent to the inbox of the requester."
    },
    "SRV.STATS.orders": {
      "address": "$SRV.STATS.orders",
      "messages": {
        "nats.micro.DiscoveryRequest": {
          "$ref": "#/components/messages/nats.micro.DiscoveryRequest"
        }
      },
      "description": "NATS micro discovery. Instances also answer on `$SRV.STATS` (all services) and `$SRV.STATS.orders.<id>` (a single instance)."
    },
    "SRV.STATS.orders.reply": {
      "address": null,
      "messages": {
        "nats.micro.StatsResponse": {
          "$ref": "#/components/messages/nats.micro.StatsResponse"
        }
      },
      "description": "Replies of the service instances, sent to the inbox of the requester."
    },
    "orders.events.order_id.placed": {
      "address": "orders.events.{order_id}.placed",
      "messages": {
        "acme.orders.v1.OrderPlacedEvent": {
          "$ref": "#/components/messages/acme.orders.v1.OrderPlacedEvent"
        }
      },
      "title": "Order placed events",
      "parameters": {
        "order_id": {
          "location": "$message.payload#/orderId"
        }
      },
      "x-nats-jetstream": {
        "stream": "ORDERS"
      }
    },
    "KV.carts.customer_id": {
      "address": "$KV.carts.{customer_id}",
      "messages": {
        "acme.orders.v1.Cart": {
          "$ref": "#/components/messages/acme.orders.v1.Cart"
        }
      },
      "parameters": {
        "customer_id": {
          "location": "$message.payload#/customerId"
        }
      },
      "x-nats-jetstream": {
        "stream": "KV_carts",
        "keyValueBucket": "carts"
      }
    },
    "jetstream.pubAck": {
      "address": null,
      "messages": {
        "nats.jetstream.PubAck": {
          "$ref": "#/components/messages/nats.jetstream.PubAck"
        }
      },
      "description": "JetStream publish acknowledgements, delivered to the reply subject (inbox) of the publish request."
    }
  },
  "operations": {
    "OrderService.PlaceOrder": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/orders.place"
      },
      "summary": "Places a new order.",
      "description": "Places a new order.\n\nThe order is validated, persisted and an `OrderPlaced` event is\npublished.",
      "tags": [
        {
          "name": "OrderService"
        }
      ],
      "bindings": {
        "nats": {
          "queue": "q",
          "bindingVersion": "0.1.0"
        }
      },
      "messages": [
        {
          "$ref": "#/channels/orders.place/messages/acme.orders.v1.PlaceOrderRequest"
        }
      ],
      "reply": {
        "channel": {
          "$ref": "#/channels/orders.place.reply"
        },
        "messages": [
          {
            "$ref": "#/channels/orders.place.reply/messages/acme.orders.v1.Order"
          },
          {
            "$ref": "#/channels/orders.place.reply/messages/nats.micro.Error"
          }
        ]
      },
      "x-nats-micro": {
        "service": "orders",
        "endpoint": "PlaceOrder"
      },
      "x-protobuf-method": "acme.orders.v1.OrderService.PlaceOrder"
    },
    "OrderService.GetOrder": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/orders.order_id.get"
      },
      "summary": "Looks up an order by ID.",
      "tags": [
        {
          "name": "OrderService"
        }
      ],
      "bindings": {
        "nats": {
          "queue": "q",
          "bindingVersion": "0.1.0"
        }
      },
      "messages": [
        {
          "$ref": "#/channels/orders.order_id.get/messages/acme.orders.v1.GetOrderRequest"
        }
      ],
      "reply": {
        "channel": {
          "$ref": "#/channels/orders.order_id.get.reply"
        },
        "messages": [
          {
            "$ref": "#/channels/orders.order_id.get.reply/messages/acme.orders.v1.Order"
          },
          {
            "$ref": "#/channels/orders.order_id.get.reply/messages/nats.micro.Error"
          }
        ]
      },
      "x-nats-micro": {
        "service": "orders",
        "endpoint": "GetOrder"
      },
      "x-protobuf-method": "acme.orders.v1.OrderService.GetOrder"
    },
    "OrderService.discovery.PING": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/SRV.PING.orders"
      },
      "summary": "Discovers running instances of the service.",
      "tags": [
        {
          "name": "OrderService"
        }
      ],
      "messages": [
        {
          "$ref": "#/channels/SRV.PING.orders/messages/nats.micro.DiscoveryRequest"
        }
      ],
      "reply": {
        "channel": {
          "$ref": "#/channels/SRV.PING.orders.reply"
        },
        "messages": [
          {
            "$ref": "#/channels/SRV.PING.orders.reply/messages/nats.micro.PingResponse"
          }
        ]
      },
      "x-nats-micro": {
        "service": "orders",
        "discovery": "PING"
      }
    },
    "OrderService.discovery.INFO": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/SRV.INFO.orders"
      },
      "summary": "Returns the endpoints and metadata of the service instances.",
      "tags": [
        {
          "name": "OrderService"
        }
      ],
      "messages": [
        {
          "$ref": "#/channels/SRV.INFO.orders/messages/nats.micro.DiscoveryRequest"
        }
      ],
      "reply": {
        "channel": {
          "$ref": "#/channels/SRV.INFO.orders.reply"
        },
        "messages": [
          {
            "$ref": "#/channels/SRV.INFO.orders.reply/messages/nats.micro.InfoResponse"
          }
        ]
      },
      "x-nats-micro": {
        "service": "orders",
        "discovery": "INFO"
      }
    },
    "OrderService.discovery.STATS": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/SRV.STATS.orders"
      },
      "summary": "Returns request statistics of the service instances.",
      "tags": [
        {
          "name": "OrderService"
        }
      ],
      "messages": [
        {
          "$ref": "#/channels/SRV.STATS.orders/messages/nats.micro.DiscoveryRequest"
        }
      ],
      "reply": {
        "channel": {
          "$ref": "#/channels/SRV.STATS.orders.reply"
        },
        "messages": [
          {
            "$ref": "#/channels/SRV.STATS.orders.reply/messages/nats.micro.StatsResponse"
          }
        ]
      },
      "x-nats-micro": {
        "service": "orders",
        "discovery": "STATS"
      }
    },
    "OrderEvents.OrderPlaced": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/orders.events.order_id.placed"
      },
      "summary": "Emitted once an order has been placed.",
      "tags": [
        {
          "name": "OrderEvents"
        }
      ],
      "messages": [
        {
          "$ref": "#/channels/orders.events.order_id.placed/messages/acme.orders.v1.OrderPlacedEvent"
        }
      ],
      "reply": {
        "channel": {
          "$ref": "#/channels/jetstream.pubAck"
        },
        "messages": [
          {
            "$ref": "#/channels/jetstream.pubAck/messages/nats.jetstream.PubAck"
          }
        ]
      },
      "x-protobuf-method": "acme.orders.v1.OrderEvents.OrderPlaced"
    },
    "Fulfilment.ShipOrder": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/orders.events.order_id.placed"
      },
      "summary": "Ships placed orders.",
      "tags": [
        {
          "name": "Fulfilment"
        }
      ],
      "messages": [
        {
          "$ref": "#/channels/orders.events.order_id.placed/messages/acme.orders.v1.OrderPlacedEvent"
        }
      ],
      "x-nats-jetstream": {
        "stream": "ORDERS",
        "consumerKind": "pull",
        "consumer": {
          "durable_name": "fulfilment",
          "ack_policy": "explicit",
          "ack_wait": 30000000000,
          "max_deliver": 5,
          "backoff": [
            1000000000,
            5000000000,
            30000000000
          ],
          "filter_subject": "orders.events.*.placed"
        }
      },
      "x-protobuf-method": "acme.orders.v1.Fulfilment.ShipOrder"
    },
    "Fulfilment.UpdateCart": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/KV.carts.customer_id"
      },
      "summary": "Keeps carts up to date.",
      "tags": [
        {
          "name": "Fulfilment"
        }
      ],
      "messages": [
        {
          "$ref": "#/channels/KV.carts.customer_id/messages/acme.orders.v1.Cart"
        }
      ],
      "reply": {
        "channel": {
          "$ref": "#/channels/jetstream.pubAck"
        },
        "messages": [
          {
            "$ref": "#/channels/jetstream.pubAck/messages/nats.jetstream.PubAck"
          }
        ]
      },
      "x-protobuf-method": "acme.orders.v1.Fulfilment.UpdateCart"
    }
  },
  "components": {
    "schemas": {
      "acme.orders.v1.PlaceOrderRequest": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/acme.orders.v1.LineItem"
            }
          },
          "cardToken": {
            "type": "string"
          },
          "voucherCode": {
            "type": "string"
          }
        },
        "required": [
          "customerId"
        ],
        "oneOf": [
          {
            "required": [
              "cardToken"
            ]
          },
          {
            "required": [
              "voucherCode"
            ]
          },
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "cardToken"
                  ]
                },
                {
                  "required": [
                    "voucherCode"
                  ]
                }
              ]
            }
          }
        ]
      },
      "acme.orders.v1.LineItem": {
        "description": "A line of an order.",
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        }
      },
      "acme.orders.v1.Order": {
        "description": "An order.",
        "type": "object",
        "properties": {
          "orderId": {
            "description": "Unique order ID.",
            "type": "string",
            "examples": [
              "ord_123"
            ]
          },
          "customerId": {
            "description": "Customer that placed the order.",
            "type": "string"
          },
          "items": {
            "description": "Ordered items.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/acme.orders.v1.LineItem"
            }
          },
          "status": {
            "description": "Current status.",
            "allOf": [
              {
                "$ref": "#/components/schemas/acme.orders.v1.Order.Status"
              }
            ]
          },
          "placedAt": {
            "description": "When the order was placed.",
            "type": "string",
            "format": "date-time"
          },
          "totalCents": {
            "description": "Total in cents.",
            "type": "string",
            "format": "int64",
            "pattern": "^-?[0-9]+$"
          }
        }
      },
      "acme.orders.v1.Order.Status": {
        "description": "Lifecycle of an order.\n\n- `STATUS_PENDING` (1): Awaiting payment.\n- `STATUS_PAID` (2): Paid and ready to ship.\n- `STATUS_SHIPPED` (3): Handed over to the carrier.",
        "type": "string",
        "enum": [
          "STATUS_UNSPECIFIED",
          "STATUS_PENDING",
          "STATUS_PAID",
          "STATUS_SHIPPED"
        ]
      },
      "acme.orders.v1.GetOrderRequest": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          }
        },
        "required": [
          "orderId"
        ]
      },
      "nats.micro.PingResponse": {
        "description": "Reply to `$SRV.PING` (`io.nats.micro.v1.ping_response`).",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "io.nats.micro.v1.ping_response"
          },
          "name": {
            "description": "Service name.",
            "type": "string"
          },
          "id": {
            "description": "Instance identifier.",
            "type": "string"
          },
          "version": {
            "description": "Service version (semver).",
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "type",
          "name",
          "id",
          "version"
        ]
      },
      "nats.micro.InfoResponse": {
        "description": "Reply to `$SRV.INFO` (`io.nats.micro.v1.info_response`).",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "io.nats.micro.v1.info_response"
          },
          "name": {
            "description": "Service name.",
            "type": "string"
          },
          "id": {
            "description": "Instance identifier.",
            "type": "string"
          },
          "version": {
            "description": "Service version (semver).",
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "description": {
            "description": "Service description.",
            "type": "string"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "description": "Endpoint name.",
                  "type": "string"
                },
                "subject": {
                  "description": "Subject the endpoint listens on.",
                  "type": "string"
                },
                "queue_group": {
                  "description": "Queue group of the endpoint.",
                  "type": "string"
                },
                "metadata": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "required": [
          "type",
          "name",
          "id",
          "version"
        ]
      },
      "nats.micro.StatsResponse": {
        "description": "Reply to `$SRV.STATS` (`io.nats.micro.v1.stats_response`).",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "io.nats.micro.v1.stats_response"
          },
          "name": {
            "description": "Service name.",
            "type": "string"
          },
          "id": {
            "description": "Instance identifier.",
            "type": "string"
          },
          "version": {
            "description": "Service version (semver).",
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "started": {
            "description": "Start time of the instance.",
            "type": "string",
            "format": "date-time"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "description": "Endpoint name.",
                  "type": "string"
                },
                "subject": {
                  "description": "Subject the endpoint listens on.",
                  "type": "string"
                },
                "queue_group": {
                  "description": "Queue group of the endpoint.",
                  "type": "string"
                },
                "num_requests": {
                  "description": "Number of requests received.",
                  "type": "integer"
                },
                "num_errors": {
                  "description": "Number of errors returned.",
                  "type": "integer"
                },
                "last_error": {
                  "description": "Last error returned.",
                  "type": "string"
                },
                "processing_time": {
                  "description": "Total processing time in nanoseconds.",
                  "type": "integer"
                },
                "average_processing_time": {
                  "description": "Average processing time in nanoseconds.",
                  "type": "integer"
                },
                "data": {
                  "description": "Custom statistics."
                }
              }
            }
          }
        },
        "required": [
          "type",
          "name",
          "id",
          "version"
        ]
      },
      "acme.orders.v1.OrderPlacedEvent": {
        "description": "Published when an order has been placed.",
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          },
          "order": {
            "$ref": "#/components/schemas/acme.orders.v1.Order"
          }
        }
      },
      "acme.orders.v1.Cart": {
        "description": "A shopping cart.",
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/acme.orders.v1.LineItem"
            }
          },
          "coupon": {
            "type": "string"
          }
        }
      },
      "nats.jetstream.PubAck": {
        "type": "object",
        "properties": {
          "stream": {
            "description": "Stream the message was stored in.",
            "type": "string"
          },
          "seq": {
            "description": "Sequence of the message in the stream.",
            "type": "integer",
            "minimum": 0
          },
          "duplicate": {
            "description": "The message was a duplicate and was not stored again.",
            "type": "boolean"
          },
          "domain": {
            "description": "JetStream domain.",
            "type": "string"
          },
          "batch": {
            "description": "Batch identifier for atomic batch publishes.",
            "type": "string"
          },
          "count": {
            "description": "Number of messages committed by an atomic batch.",
            "type": "integer"
          },
          "error": {
            "description": "Set when the message was rejected.",
            "type": "object",
            "properties": {
              "code": {
                "type": "integer"
              },
              "err_code": {
                "type": "integer"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "messages": {
      "acme.orders.v1.PlaceOrderRequest": {
        "payload": {
          "$ref": "#/components/schemas/acme.orders.v1.PlaceOrderRequest"
        },
        "name": "PlaceOrderRequest",
        "x-protobuf-message": "acme.orders.v1.PlaceOrderRequest"
      },
      "acme.orders.v1.Order": {
        "payload": {
          "$ref": "#/components/schemas/acme.orders.v1.Order"
        },
        "name": "Order",
        "summary": "An order.",
        "examples": [
          {
            "payload": {
              "orderId": "ord_123"
            }
          }
        ],
        "x-protobuf-message": "acme.orders.v1.Order"
      },
      "nats.micro.Error": {
        "headers": {
          "type": "object",
          "properties": {
            "Nats-Service-Error": {
              "description": "Error description.",
              "type": "string"
            },
            "Nats-Service-Error-Code": {
              "description": "Error code.",
              "type": "string",
              "pattern": "^[0-9]+$"
