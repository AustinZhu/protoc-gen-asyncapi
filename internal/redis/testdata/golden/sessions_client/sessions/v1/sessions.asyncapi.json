{
  "asyncapi": "3.1.0",
  "info": {
    "title": "Sessions",
    "version": "2.0.0",
    "description": "Session management with keyspace notifications."
  },
  "servers": {
    "cluster": {
      "host": "redis.acme.example:6379",
      "protocol": "redis",
      "security": [
        {
          "$ref": "#/components/securitySchemes/acl"
        }
      ],
      "bindings": {
        "x-redis": {
          "mode": "cluster",
          "tls": true,
          "resp": 3,
          "notifyKeyspaceEvents": "Ex",
          "bindingVersion": "0.1.0"
        }
      }
    },
    "sentinel": {
      "host": "sentinel.acme.example:26379",
      "protocol": "redis",
      "security": [
        {
          "$ref": "#/components/securitySchemes/password"
        }
      ],
      "bindings": {
        "x-redis": {
          "mode": "sentinel",
          "sentinelMaster": "sessions",
          "database": 2,
          "bindingVersion": "0.1.0"
        }
      }
    },
    "local": {
      "host": "localhost:6379",
      "protocol": "redis",
      "security": [
        {
          "$ref": "#/components/securitySchemes/mtls"
        }
      ]
    }
  },
  "defaultContentType": "application/json",
  "channels": {
    "sessions.revoked": {
      "address": "sessions:revoked",
      "messages": {
        "sessions.v1.SessionRevoked": {
          "$ref": "#/components/messages/sessions.v1.SessionRevoked"
        }
      },
      "bindings": {
        "x-redis": {
          "type": "pubsub",
          "bindingVersion": "0.1.0"
        }
      }
    },
    "sessions.logins": {
      "address": "sessions:logins",
      "messages": {
        "sessions.v1.LoginAttempt": {
          "$ref": "#/components/messages/sessions.v1.LoginAttempt"
        }
      },
      "bindings": {
        "x-redis": {
          "type": "stream",
          "entryField": "payload",
          "bindingVersion": "0.1.0"
        }
      }
    }
  },
  "components": {
    "schemas": {
      "sessions.v1.SessionRevoked": {
        "description": "Broadcast when a session is revoked; documented without an rpc.",
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          }
        }
      },
      "sessions.v1.LoginAttempt": {
        "description": "Kept in a stream for audits.",
        "type": "object",
        "properties": {
          "user": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          }
        }
      }
    },
    "messages": {
      "sessions.v1.SessionRevoked": {
        "payload": {
          "$ref": "#/components/schemas/sessions.v1.SessionRevoked"
        },
        "name": "SessionRevoked",
        "summary": "Broadcast when a session is revoked; documented without an rpc.",
        "x-protobuf-message": "sessions.v1.SessionRevoked"
      },
      "sessions.v1.LoginAttempt": {
        "payload": {
          "$ref": "#/components/schemas/sessions.v1.LoginAttempt"
        },
        "name": "LoginAttempt",
        "summary": "Kept in a stream for audits.",
        "x-protobuf-message": "sessions.v1.LoginAttempt"
      }
    },
    "securitySchemes": {
      "acl": {
        "type": "userPassword",
        "x-redis-auth": "acl"
      },
      "password": {
        "type": "userPassword",
        "x-redis-auth": "password"
      },
      "mtls": {
        "type": "X509",
        "x-redis-auth": "tls"
      }
    }
  }
}
